<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KeyboardLight.MainWindow"
        Title="Keyboard Light" Width="500" Height="720"
        Background="#1e1e2e">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">

      <TextBlock Text="⌨ Keyboard Light" FontSize="22" FontWeight="Bold"
                 Foreground="#cdd6f4" HorizontalAlignment="Center"/>

      <!-- Mod: Tek renk / 4 Bölge -->
      <Border Background="#313244" CornerRadius="10" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Mod" Foreground="#a6adc8" FontSize="13"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <RadioButton x:Name="ModeSingle" Content="Tek Renk" IsChecked="True" Foreground="#cdd6f4" Click="OnModeChanged"/>
            <RadioButton x:Name="ModeZone"   Content="4 Bölge"  Foreground="#cdd6f4" Click="OnModeChanged"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Tek Renk Paneli -->
      <Border x:Name="SinglePanel" Background="#313244" CornerRadius="10" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Renk (HEX)" Foreground="#a6adc8" FontSize="13"/>
          <Grid ColumnDefinitions="*,12,48">
            <TextBox x:Name="HexInput" Text="FF0000"
                     Foreground="#cdd6f4" Background="#45475a"
                     CornerRadius="6" Padding="10,8"/>
            <Border Grid.Column="2" x:Name="ColorPreview" CornerRadius="6"
                    Background="#FF0000" Width="48" Height="36"/>
          </Grid>
          <WrapPanel>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#FF0000" CornerRadius="6" Tag="FF0000" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#00FF00" CornerRadius="6" Tag="00FF00" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#0000FF" CornerRadius="6" Tag="0000FF" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#FF00FF" CornerRadius="6" Tag="FF00FF" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#00FFFF" CornerRadius="6" Tag="00FFFF" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#FFFF00" CornerRadius="6" Tag="FFFF00" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#FF6600" CornerRadius="6" Tag="FF6600" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#FF1493" CornerRadius="6" Tag="FF1493" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#7B00FF" CornerRadius="6" Tag="7B00FF" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#00FF88" CornerRadius="6" Tag="00FF88" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#FF8800" CornerRadius="6" Tag="FF8800" Click="OnPresetColor"/>
            <Button Width="32" Height="32" Margin="0,0,6,6" Background="#FFFFFF" CornerRadius="6" Tag="FFFFFF" Click="OnPresetColor"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 4 Bölge Paneli -->
      <Border x:Name="ZonePanel" Background="#313244" CornerRadius="10" Padding="16" IsVisible="False">
        <StackPanel Spacing="12">
          <TextBlock Text="4 Bölge Renk (HEX)" Foreground="#a6adc8" FontSize="13"/>

          <!-- Bölge 1 -->
          <StackPanel Spacing="4">
            <TextBlock Text="Bölge 1" Foreground="#a6adc8" FontSize="12"/>
            <Grid ColumnDefinitions="*,12,48">
              <TextBox x:Name="Zone1Input" Text="FF0000" Foreground="#cdd6f4" Background="#45475a" CornerRadius="6" Padding="10,8"/>
              <Border Grid.Column="2" x:Name="Zone1Preview" CornerRadius="6" Background="#FF0000" Width="48" Height="36"/>
            </Grid>
            <WrapPanel>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF0000" CornerRadius="5" Tag="Z1:FF0000" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#00FF00" CornerRadius="5" Tag="Z1:00FF00" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#0000FF" CornerRadius="5" Tag="Z1:0000FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF00FF" CornerRadius="5" Tag="Z1:FF00FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#00FFFF" CornerRadius="5" Tag="Z1:00FFFF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FFFF00" CornerRadius="5" Tag="Z1:FFFF00" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF6600" CornerRadius="5" Tag="Z1:FF6600" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#7B00FF" CornerRadius="5" Tag="Z1:7B00FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FFFFFF" CornerRadius="5" Tag="Z1:FFFFFF" Click="OnZonePreset"/>
            </WrapPanel>
          </StackPanel>

          <!-- Bölge 2 -->
          <StackPanel Spacing="4">
            <TextBlock Text="Bölge 2" Foreground="#a6adc8" FontSize="12"/>
            <Grid ColumnDefinitions="*,12,48">
              <TextBox x:Name="Zone2Input" Text="00FF00" Foreground="#cdd6f4" Background="#45475a" CornerRadius="6" Padding="10,8"/>
              <Border Grid.Column="2" x:Name="Zone2Preview" CornerRadius="6" Background="#00FF00" Width="48" Height="36"/>
            </Grid>
            <WrapPanel>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF0000" CornerRadius="5" Tag="Z2:FF0000" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#00FF00" CornerRadius="5" Tag="Z2:00FF00" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#0000FF" CornerRadius="5" Tag="Z2:0000FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF00FF" CornerRadius="5" Tag="Z2:FF00FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#00FFFF" CornerRadius="5" Tag="Z2:00FFFF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FFFF00" CornerRadius="5" Tag="Z2:FFFF00" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF6600" CornerRadius="5" Tag="Z2:FF6600" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#7B00FF" CornerRadius="5" Tag="Z2:7B00FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FFFFFF" CornerRadius="5" Tag="Z2:FFFFFF" Click="OnZonePreset"/>
            </WrapPanel>
          </StackPanel>

          <!-- Bölge 3 -->
          <StackPanel Spacing="4">
            <TextBlock Text="Bölge 3" Foreground="#a6adc8" FontSize="12"/>
            <Grid ColumnDefinitions="*,12,48">
              <TextBox x:Name="Zone3Input" Text="0000FF" Foreground="#cdd6f4" Background="#45475a" CornerRadius="6" Padding="10,8"/>
              <Border Grid.Column="2" x:Name="Zone3Preview" CornerRadius="6" Background="#0000FF" Width="48" Height="36"/>
            </Grid>
            <WrapPanel>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF0000" CornerRadius="5" Tag="Z3:FF0000" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#00FF00" CornerRadius="5" Tag="Z3:00FF00" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#0000FF" CornerRadius="5" Tag="Z3:0000FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF00FF" CornerRadius="5" Tag="Z3:FF00FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#00FFFF" CornerRadius="5" Tag="Z3:00FFFF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FFFF00" CornerRadius="5" Tag="Z3:FFFF00" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF6600" CornerRadius="5" Tag="Z3:FF6600" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#7B00FF" CornerRadius="5" Tag="Z3:7B00FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FFFFFF" CornerRadius="5" Tag="Z3:FFFFFF" Click="OnZonePreset"/>
            </WrapPanel>
          </StackPanel>

          <!-- Bölge 4 -->
          <StackPanel Spacing="4">
            <TextBlock Text="Bölge 4" Foreground="#a6adc8" FontSize="12"/>
            <Grid ColumnDefinitions="*,12,48">
              <TextBox x:Name="Zone4Input" Text="FF00FF" Foreground="#cdd6f4" Background="#45475a" CornerRadius="6" Padding="10,8"/>
              <Border Grid.Column="2" x:Name="Zone4Preview" CornerRadius="6" Background="#FF00FF" Width="48" Height="36"/>
            </Grid>
            <WrapPanel>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF0000" CornerRadius="5" Tag="Z4:FF0000" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#00FF00" CornerRadius="5" Tag="Z4:00FF00" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#0000FF" CornerRadius="5" Tag="Z4:0000FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF00FF" CornerRadius="5" Tag="Z4:FF00FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#00FFFF" CornerRadius="5" Tag="Z4:00FFFF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FFFF00" CornerRadius="5" Tag="Z4:FFFF00" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FF6600" CornerRadius="5" Tag="Z4:FF6600" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#7B00FF" CornerRadius="5" Tag="Z4:7B00FF" Click="OnZonePreset"/>
              <Button Width="28" Height="28" Margin="0,0,4,4" Background="#FFFFFF" CornerRadius="5" Tag="Z4:FFFFFF" Click="OnZonePreset"/>
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Parlaklık -->
      <Border Background="#313244" CornerRadius="10" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Parlaklık" Foreground="#a6adc8" FontSize="13"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <RadioButton x:Name="Brightness1" Content="1" IsChecked="True" Foreground="#cdd6f4"/>
            <RadioButton x:Name="Brightness2" Content="2" Foreground="#cdd6f4"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Efektler -->
      <Border Background="#313244" CornerRadius="10" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Efekt" Foreground="#a6adc8" FontSize="13"/>
          <WrapPanel>
            <Button Content="Static"  Width="80" Margin="0,0,6,6" Click="OnStatic"/>
            <Button Content="Breath"  Width="80" Margin="0,0,6,6" Click="OnBreath"/>
            <Button Content="Wave →"  Width="80" Margin="0,0,6,6" Click="OnWaveRtl"/>
            <Button Content="Wave ←"  Width="80" Margin="0,0,6,6" Click="OnWaveLtr"/>
            <Button Content="Hue"     Width="80" Margin="0,0,6,6" Click="OnHue"/>
            <Button Content="Kapat"   Width="80" Margin="0,0,6,6" Background="#f38ba8" Click="OnOff"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock x:Name="StatusText" Text="Hazır" Foreground="#a6e3a1"
                 HorizontalAlignment="Center" FontSize="13"/>

    </StackPanel>
  </ScrollViewer>
</Window>